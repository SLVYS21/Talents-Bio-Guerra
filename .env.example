# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Copy the private_key value from the service account JSON.
# Keep the \n literals; the code replaces them with newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id-from-the-url

# --- Cloudinary (public: unsigned upload from the browser) ---
# 1. Créer un compte Cloudinary → Dashboard → note le "Cloud name".
# 2. Settings → Upload → Add upload preset → mode "Unsigned".
#    (Autoriser JPG/PNG/WebP, taille max 5 Mo, folder "bio-guera/portraits" recommandé.)
# 3. Coller le cloud name et le nom du preset ci-dessous.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Meta Pixel (public: sent to the browser) ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Admin ---
# Long random password (16+ chars recommended).
ADMIN_PASSWORD=change-me-to-a-long-random-string
# 32+ char random secret used to sign the admin session cookie (JWT HS256).
ADMIN_COOKIE_SECRET=change-me-to-a-32-char-plus-random-secret
